# Copy this file to .env and customize the deployment values.

# Required
SECRET_KEY=replace-with-a-random-secret
POSTGRES_PASSWORD=replace-with-a-strong-password

# Host directories and container identity
MEDIA_PATH=/path/to/your/media
SCAN_PATHS=/media
# PUID=10001
# PGID=10001

# Keep HTTPS cookie protection enabled. Set false only for plain HTTP.
# SESSION_COOKIE_SECURE=false

# Optional startup settings. Uncomment only when changing the Compose defaults.
# TZ=UTC
# CELERY_CONCURRENCY sets the worker process count.
# CELERY_CONCURRENCY=4
# CELERY_LOG_LEVEL=INFO
# MAX_WORKERS caps selected-file rescan threads; the API defaults to 4.
# MAX_WORKERS=10
# BATCH_SIZE sets the legacy discovery database lookup batch size.
# BATCH_SIZE=100
# MAX_OUTPUT_SIZE=10000
# OUTPUT_ROTATION_ENABLED=true
# FLASK_ENV=production

# Startup seeds this value only when no saved row exists; saved values win.
# FREEZE_DETECTION_ENABLED=true

# Legacy startup import only. Active exclusions are stored in PostgreSQL after
# the one-time import; these values do not override saved rules at runtime.
# EXCLUDED_PATHS=/media/temp,/media/cache
# EXCLUDED_EXTENSIONS=.tmp,.temp,.cache
# Legacy exclusions.json keys: paths, extensions, filename_patterns.
# Built-in filename patterns remain excluded after configured rules are cleared.

# Optional SSRF allowlist for internal hosts/CIDRs.
# TRUSTED_INTERNAL_HOSTS=healthcheck.internal.local,192.168.5.0/24

# Deprecated compatibility override read by app.py if passed to the process.
# Current Compose uses POSTGRES_* and does not forward DATABASE_URL.
# DATABASE_URL=postgresql://pixelprobe:password@localhost:5432/pixelprobe

# Optional startup schedules run alongside schedules stored in the database.
# PERIODIC_SCAN_SCHEDULE=cron:0 2 * * *
# CLEANUP_SCHEDULE=cron:0 3 * * 0
